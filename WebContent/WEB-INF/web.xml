<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd" id="WebApp_ID" version="3.1">
  <display-name>Vendas</display-name>

  <!-- Welcome file: redireciona para login -->
  <welcome-file-list>
    <welcome-file>login.xhtml</welcome-file>
  </welcome-file-list>

  <!-- Faces Servlet -->
  <servlet>
    <servlet-name>Faces Servlet</servlet-name>
    <servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>

  <servlet-mapping>
    <servlet-name>Faces Servlet</servlet-name>
    <url-pattern>*.xhtml</url-pattern>
  </servlet-mapping>

  <!-- PrimeFaces Theme -->
  <context-param>
    <param-name>primefaces.THEME</param-name>
    <param-value>sam</param-value>
  </context-param>

  <!-- JSF Project Stage -->
  <context-param>
    <param-name>javax.faces.PROJECT_STAGE</param-name>
    <param-value>Development</param-value>
  </context-param>

  <!-- Security Filter -->
  <filter>
    <filter-name>SecurityFilter</filter-name>
    <filter-class>br.com.vendas.security.SecurityFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>SecurityFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Listener Hibernate -->
  <listener>
    <listener-class>br.com.vendas.util.ContextListener</listener-class>
  </listener>

  <!-- Error pages -->
  <error-page>
    <error-code>403</error-code>
    <location>/login.xhtml</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/pages/principal.xhtml</location>
  </error-page>

</web-app>
